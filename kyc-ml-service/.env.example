# ---------------------------------------------------------------------------
# KYC ML Service configuration
#
# Copy to `.env` and fill in your real values. Never commit `.env`.
#
#   cp .env.example .env
#
# PostgreSQL and Redis are EXTERNAL cloud services. The ML worker, the Go
# backend, and this file must all point at the same instances.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PostgreSQL (cloud)
# ---------------------------------------------------------------------------
# Neon example (sslmode=require is mandatory for Neon):
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-xxx.aws.neon.tech/neondb?sslmode=require
#
# Supabase example:
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
#
# TLS notes:
#   - Keep `?sslmode=require` (or `verify-full`) in the URL. libpq handles it.
#   - Percent-encode special characters in the username/password
#     (e.g. `p@ss` -> `p%40ss`).
#   - `postgres://` and `postgresql://` are both accepted; the worker
#     normalizes them before connecting.
#
# Same database as the Go backend.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Connection timeout in seconds (default shown).
# DB_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# Redis (cloud)
# ---------------------------------------------------------------------------
# TLS is OPTIONAL and disabled by default. Redis Cloud Free tier (and local
# Redis) does NOT support TLS, so leave REDIS_SSL=false for those setups.
#
# Redis Cloud Free tier example (plain, no TLS):
#   REDIS_HOST=redis-12345.c1.us-east-1-2.ec2.cloud.redislabs.com
#   REDIS_PORT=15012
#   REDIS_USERNAME=default
#   REDIS_PASSWORD=your-redis-password
#   REDIS_SSL=false
#
# Upstash / paid TLS example (only if your plan supports TLS):
#   REDIS_HOST=your-instance.upstash.io
#   REDIS_PORT=6380
#   REDIS_PASSWORD=your-upstash-password
#   REDIS_SSL=true
REDIS_HOST=your-redis-host.example.com
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

# false = plain redis:// connection (default, works with Redis Cloud Free tier)
# true  = TLS connection (only if your provider/plan requires it)
REDIS_SSL=false

# Optional Redis settings (defaults shown)
# REDIS_DB=0
# TLS certificate verification (only used when REDIS_SSL=true):
# required | optional | none. Use "none" only for self-signed certificates.
# REDIS_SSL_CERT_REQS=required
# REDIS_CONNECT_TIMEOUT=5
# REDIS_SOCKET_TIMEOUT=15

# ---------------------------------------------------------------------------
# Inference mode
# ---------------------------------------------------------------------------
# real = ONNX (YuNet/SFace/MiniFASNet) + PaddleOCR
# mock = deterministic scores (useful for smoke tests with fake URLs)
ML_MODE=real

# Directory containing the three ONNX files (run download_models.py).
# Docker overrides this to /app/models.
MODEL_DIR=./models

# ---------------------------------------------------------------------------
# OCR (PaddleOCR)
# ---------------------------------------------------------------------------
OCR_BACKEND=paddleocr
# en handles Latin names/digits on Aadhaar/PAN/passport. Use `hi` for
# Devanagari-first documents (English recognition becomes weaker).
OCR_LANG=en
# OCR_USE_GPU=false

# PaddleOCR's model cache (2.x uses PADDLE_OCR_BASE_DIR; 3.x PADDLE_PDX_*).
# Docker overrides these to /app/.paddleocr and /app/.paddlex.
# PADDLE_OCR_BASE_DIR=./models/paddleocr
# PADDLE_PDX_CACHE_HOME=./models/paddlex

# ---------------------------------------------------------------------------
# Face match (OpenCV YuNet + SFace)
# ---------------------------------------------------------------------------
FACE_DETECTOR_MODEL=face_detection_yunet_2023mar.onnx
FACE_RECOGNIZER_MODEL=face_recognition_sface_2021dec.onnx
FACE_DETECT_SCORE_THRESHOLD=0.80
FACE_DETECT_NMS_THRESHOLD=0.30
FACE_DETECT_TOP_K=5000
# Downscale very large uploads before detection (0-255 pixel coordinates).
FACE_DETECT_MAX_SIDE=1600

# Phase 5 multi-reference gates — a reference face failing ANY of these is
# skipped (it contributes no similarity score):
#   smallest acceptable face box side in pixels (post-detection coordinates);
#   YuNet confidence for the kept face; Laplacian variance of the face box
#   (lower = blurred).
FACE_MIN_REFERENCE_SIDE=80
FACE_MIN_DETECTION_SCORE=0.80
FACE_MIN_SHARPNESS=80.0
# Phase 5 divergence guard: when a non-Aadhaar reference wins, the raw
# priority is capped at manual_review once (max - aadhaar) exceeds this gap.
SECOND_REF_DIVERGENCE_THRESHOLD=0.25

# ---------------------------------------------------------------------------
# Liveness (MiniFASNetV2 ONNX)
# ---------------------------------------------------------------------------
LIVENESS_MODEL=MiniFASNetV2.onnx
LIVENESS_USE_GPU=false
# The bundled export expects raw BGR 0-255 and class 1 = "live".
LIVENESS_LIVE_INDEX=1
# none | div255 | pm1
LIVENESS_NORMALIZE=none
LIVENESS_CROP_SCALE=2.7

# ---------------------------------------------------------------------------
# Document download limits
# ---------------------------------------------------------------------------
IMAGE_CONNECT_TIMEOUT=10
IMAGE_DOWNLOAD_TIMEOUT=30
MAX_IMAGE_BYTES=15728640

# ---------------------------------------------------------------------------
# AI decision thresholds
# ---------------------------------------------------------------------------
# Face matching — OpenCV SFace cosine similarity.
# 0.363 is the vendor-calibrated "same person" line (LFW 99.6%).
# 0.300 is the ambiguous lower bound; below it, route to manual.
# 0.240 is the confidently-different floor; used for fraud reject only
#       when liveness also fails. Never reject on face alone.
THRESHOLD_FACE_AUTO_PASS=0.363
THRESHOLD_FACE_REVIEW=0.300
THRESHOLD_FACE_REJECT=0.240
SHADOW_MODE=true

# Decision-policy version stamped on completed records (and read by the Go
# router under the same key). Bump together with the backend when thresholds
# change so stale decisions can be traced back to their policy.
KYC_POLICY_VERSION=phase3-v1

# Liveness: >= PASS -> live, < REJECT -> hard reject,
# anything in between -> manual review.
THRESHOLD_LIVE_PASS=0.90
THRESHOLD_LIVE_REJECT=0.50

# OCR: >= PASS required for auto_eligible; below -> manual review.
THRESHOLD_OCR_PASS=0.80

# ---------------------------------------------------------------------------
# Aadhaar Secure QR verification (Phase 2.5)
# ---------------------------------------------------------------------------
# Master switch. false = skip QR verification entirely (Phase 1 behaviour).
QR_DECODE_ENABLED=true
# Phase 5 rollout flag. Phase 2.5 only records it; routing does not change.
QR_VERIFICATION_REQUIRED=false
# Wall-clock upper bound for a single QR decode attempt (seconds).
QR_MAX_DECODE_SECONDS=3.0

# ---------------------------------------------------------------------------
# Worker / Redis Stream settings (defaults shown)
# ---------------------------------------------------------------------------
# KYC_STREAM=kyc:verification:jobs
# KYC_CONSUMER_GROUP=kyc_ml_workers
# KYC_CONSUMER_NAME=
# KYC_BATCH_SIZE=10
# KYC_BLOCK_MS=5000
# WORKER_RECONNECT_DELAY_SECONDS=5
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Mock model outputs (used only with ML_MODE=mock)
# Changing them is a quick way to exercise each review_priority branch.
# ---------------------------------------------------------------------------
MOCK_OCR_CONFIDENCE=0.95
MOCK_FACE_SIMILARITY=0.88
MOCK_LIVENESS_SCORE=0.96
