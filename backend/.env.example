# Document-in-selfie gate
DOC_IN_SELFIE_APPROVE_THRESHOLD=75
DOC_IN_SELFIE_MANUAL_THRESHOLD=25
DOC_IN_SELFIE_REJECT_ON_MISMATCH=true

# Set to false if UIDAI QR certs are unavailable
THRESHOLD_REQUIRE_QR=true

# HMAC pepper for hashing client IPs. MUST be set in production.
# Generate with: openssl rand -hex 32
KYC_IP_HASH_PEPPER=
# Comma-separated CIDRs of trusted load balancers/ingress that
# are allowed to send X-Forwarded-For. Empty = trust NO XFF.
KYC_TRUSTED_PROXY_CIDRS=

# 30-day KYC document retention (DPDP Act compliance)
# Documents older than this for approved/rejected records are
# deleted from Cloudinary and DB URLs are nulled.
# Set higher if legal team requires. Do NOT set below 30.
KYC_DOC_RETENTION_DAYS=30
