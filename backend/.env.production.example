# =============================================================================
# TechGuild backend - PRODUCTION environment template
# =============================================================================
# Copy this file to `.env` on the VPS and replace every placeholder:
#
#   cp .env.production.example .env
#   chmod 600 .env
#
# Never commit `.env`. Prefer your host's secret manager or a root-owned env
# file over plaintext secrets in the repository.
#
# Production checklist:
#   [ ] APP_ENV=production and GIN_MODE=release
#   [ ] DATABASE_URL points at the managed production database with sslmode=require
#   [ ] Redis points at the production instance (TLS if the provider requires it)
#   [ ] Every secret below is freshly generated (never reuse development values)
#   [ ] OAuth callback URLs updated in the Google/GitHub consoles
#   [ ] Razorpay live keys + webhook secret configured
#   [ ] SMTP uses an app password, not a personal account password
#   [ ] FRONTEND_URL / ZUDOKU_URL use the real HTTPS domains
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=TechGuild
APP_ENV=production
PORT=8080
GIN_MODE=release

# Public HTTPS endpoints (no trailing slash).
# FRONTEND_URL and ZUDOKU_URL also drive CORS; comma-separated extra origins
# are supported, e.g. FRONTEND_URL=https://app.example.com,https://www.example.com
SERVER_PUBLIC_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
ZUDOKU_URL=https://docs.example.com

# --- PostgreSQL (managed cloud) ---------------------------------------------
# Neon / Supabase / RDS: keep sslmode=require (or verify-full).
# Percent-encode special characters in the username/password.
DATABASE_URL=postgresql://USER:PASSWORD@db.example.com:5432/techguild?sslmode=require

# --- Redis (managed cloud) ---------------------------------------------------
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=CHANGE_ME
# true for TLS endpoints (Upstash / ElastiCache TLS), false for plain Redis.
REDIS_SSL=true

# --- Auth and crypto secrets -------------------------------------------------
# Generate each with: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_CHARS

# Salt used to hash government IDs / business PANs.
# Use a long random value and do not rotate it without a data migration plan
# (existing hashes would stop matching).
HASH_SALT=CHANGE_ME_LONG_RANDOM_STRING

# AES-256 key for bank account / payout details PII (EncryptSecret /
# DecryptSecret): EXACTLY 32 characters. This is NOT a 2FA key.
#
# Renamed from the misleading TWO_FA_ENCRYPTION_KEY. When migrating, keep the
# SAME value under the new name so existing ciphertext still decrypts; rotating
# this key without a re-encryption migration makes old data unreadable.
# Generate with: openssl rand -base64 24   (24 bytes -> 32 base64 chars)
BANK_DETAILS_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_KEY

# TOTP secret encryption key (2FA/TOTP only): base64 encoding of exactly 32
# random bytes.
# Generate with: openssl rand -base64 32
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
# Separate secret for short-lived 2FA challenge tokens.
TWO_FACTOR_TEMP_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# --- Email / SMTP ------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_EMAIL=no-reply@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD

# --- OAuth (optional; leave a provider blank to disable it) ------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.example.com/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://api.example.com/auth/github/callback

# --- Cloudinary --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# --- Payments ----------------------------------------------------------------
# Use razorpay in production; "mock" is for local development only.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
RAZORPAYX_KEY_ID=CHANGE_ME
RAZORPAYX_KEY_SECRET=CHANGE_ME
RAZORPAYX_ACCOUNT_NUMBER=CHANGE_ME
CLIENT_PROCESSING_FEE_BPS=500
FREELANCER_PROCESSING_FEE_BPS=500

# =============================================================================
# KYC Phase 3 — Go router
# =============================================================================
# Shadow mode: when true, ALL records route to manual_review.
# Must match the SHADOW_MODE env var of the Python worker exactly; a mismatch
# makes the router override Python's routing (LoadConfig logs an assertion).
KYC_SHADOW_MODE=true

# Deterministic cohort for shadow-off rollout. 0 = nobody,
# 100 = everybody. Uses HMAC(user_id) % 100 < PCT.
KYC_ROLLOUT_COHORT_PCT=0

KYC_POLICY_VERSION=phase3-v1
KYC_ROUTER_INTERVAL_SECONDS=60

# These mirror the Python worker thresholds (see .env.production.example in
# the kyc-ml-service directory). Change both files together or the evidence
# gates will diverge.
THRESHOLD_FACE_AUTO_PASS=0.363
THRESHOLD_FACE_REVIEW=0.300
THRESHOLD_FACE_REJECT=0.240
THRESHOLD_LIVE_PASS=0.90
THRESHOLD_LIVE_REJECT=0.50
THRESHOLD_OCR_PASS=0.80

# Phase 5 multi-reference: minimum aadhaar_similarity required for
# auto-approval even when PAN wins the face match. Keep at least 0.05 below
# THRESHOLD_FACE_AUTO_PASS so a marginal Aadhaar can ride a strong PAN to
# approval, but strong enough that an unverified/other-person Aadhaar is
# blocked. Mirror of the Python worker's divergence guardrail.
THRESHOLD_AADHAAR_FLOOR=0.35
